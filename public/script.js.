const express = require('express');
const http = require('http');
const WebSocket = require('ws');
const path = require('path');

const app = express();
const servidor = http.createServer(app);

// Configura o WebSocket com limite de payload aumentado para 10MB (suporta fotos e áudios)
const wss = new WebSocket.Server({ 
    server: servidor,
    maxPayload: 10 * 1024 * 1024 // 10 Megabytes
});

// Serve os arquivos da pasta 'public' (onde está o seu index.html)
app.use(express.static(path.join(__dirname, 'public')));

// Histórico de mensagens mantido em memória
let historicoMensagens = [];

wss.on('connection', (ws) => {
    ws.isAlive = true;
    
    ws.on('pong', () => {
        ws.isAlive = true;
    });

    // Envia o histórico assim que o cliente conecta
    ws.send(JSON.stringify({
        tipo: 'historico',
        conteudo: historicoMensagens
    }));

    // Processamento de novas mensagens e comandos
    ws.on('message', (mensagem) => {
        try {
            const dados = JSON.parse(mensagem);

            // 1. Recebe e retransmite uma mensagem normal (texto, foto, áudio)
            if (dados.tipoEvent === 'nova_mensagem') {
                historicoMensagens.push(dados.conteudo);
                
                // Mantém apenas as últimas 100 mensagens no servidor para não pesar
                if (historicoMensagens.length > 100) {
                    historicoMensagens.shift();
                }

                wss.clients.forEach((cliente) => {
                    if (cliente.readyState === WebSocket.OPEN) {
                        cliente.send(JSON.stringify({
                            tipo: 'nova_mensagem',
                            conteudo: dados.conteudo
                        }));
                    }
                });
            } 
            // 2. Confirma a leitura (✓✓)
            else if (dados.tipoEvent === 'confirmar_leitura') {
                const msgAlvo = historicoMensagens.find(m => m.id === dados.idMensagem);
                if (msgAlvo) msgAlvo.lida = true;

                wss.clients.forEach((cliente) => {
                    if (cliente.readyState === WebSocket.OPEN) {
                        cliente.send(JSON.stringify({
                            tipo: 'mensagem_lida_confirmada',
                            idMensagem: dados.idMensagem
                        }));
                    }
                });
            }
            // 3. Aviso de "Digitando..."
            else if (dados.tipoEvent === 'digitando') {
                wss.clients.forEach((cliente) => {
                    if (cliente !== ws && cliente.readyState === WebSocket.OPEN) {
                        cliente.send(JSON.stringify({
                            tipo: 'usuario_digitando',
                            remetente: dados.remetente,
                            estado: dados.estado
                        }));
                    }
                });
            }
            // 4. O COMANDO SECRETO PARA APAGAR O SERVIDOR (000000)
            else if (dados.tipoEvent === 'limpar_historico') {
                historicoMensagens = []; // Zera a memória do servidor
                wss.clients.forEach((cliente) => {
                    if (cliente.readyState === WebSocket.OPEN) {
                        cliente.send(JSON.stringify({
                            tipo: 'historico_limpo' // Manda todos os tablets/PCs limparem a tela
                        }));
                    }
                });
            }
        } catch (erro) {
            console.error("Erro ao processar pacote recebido:", erro);
        }
    });

    ws.on('error', (erro) => {
        console.error("Erro na conexão WebSocket:", erro);
    });
});

// Monitoramento de conexões ativas a cada 25 segundos para manter a linha aberta
const intervaloMonitor = setInterval(() => {
    wss.clients.forEach((ws) => {
        if (ws.isAlive === false) return ws.terminate();
        ws.isAlive = false;
        ws.ping();
    });
}, 25000);

wss.on('close', () => {
    clearInterval(intervaloMonitor);
});

// Inicialização blindada com '0.0.0.0' para hospedagem no Render
const PORTA = process.env.PORT || 3000;
servidor.listen(PORTA, '0.0.0.0', () => {
    console.log(`[O OBSERVADOR] Servidor rodando na porta ${PORTA}`);
});
