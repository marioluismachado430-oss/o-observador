// public/script.js

const SENHA_SECRETA = "106230";

function verificarSenha() {
    const input = document.getElementById('campoBusca');
    const telaJornal = document.getElementById('telaJornal');
    const telaChat = document.getElementById('telaChat');

    if (!input) return;

    const valorDigitado = input.value.trim();

    if (valorDigitado === SENHA_SECRETA) {
        input.value = "";
        // Oculta o jornal e mostra o chat de forma direta e forçada
        telaJornal.style.display = 'none';
        telaChat.style.display = 'flex';
    } else {
        alert("Senha incorreta!");
        input.value = "";
    }
}

function enviarMensagem() {
    const msgInput = document.getElementById('mensagemInput');
    const area = document.getElementById('areaMensagens');

    if (msgInput && msgInput.value.trim() !== "") {
        const novaMsg = document.createElement('div');
        novaMsg.style.background = "#dcf8c6";
        novaMsg.style.padding = "8px 12px";
        novaMsg.style.margin = "5px 0";
        novaMsg.style.borderRadius = "5px";
        novaMsg.style.maxWidth = "70%";
        novaMsg.style.alignSelf = "flex-end";
        novaMsg.innerText = msgInput.value;
        
        area.appendChild(novaMsg);
        msgInput.value = "";
    }
}
