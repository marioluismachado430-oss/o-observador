// public/script.js

const SENHA_CORRETA = "admin123";
const TEMPO_INATIVIDADE = 30000; // 30 segundos
let cronometroInatividade;
let socket = null;

const telaJornal = document.getElementById('telaJornal');
const telaChat = document.getElementById('telaChat');
const campoBusca = document.getElementById('campoBusca');
const gradeNoticias = document.getElementById('gradeNoticias');
const areaMensagens = document.getElementById('areaMensagens');
const mensagemInput = document.getElementById('mensagemInput');
const arquivoInput = document.getElementById('arquivoInput');

// 1. CARREGAR NOTÍCIAS REAIS DO IBGE
async function carregarNoticias() {
    try {
        const resposta = await fetch('https://servicodados.ibge.gov.br/api/3/noticias/?qtd=6');
        const dados = await resposta.json();
        gradeNoticias.innerHTML = ""; 
        dados.items.forEach(noticia => {
            const cartao = document.createElement('div');
            cartao.className = 'noticia-cartao';
            cartao.innerHTML = `<h3>${noticia.titulo}</h3><p>${noticia.introducao}</p>`;
            gradeNoticias.appendChild(cartao);
        });
    } catch (erro) {
        gradeNoticias.innerHTML = "<p>Nenhum resultado encontrado no acervo.</p>";
    }
}
carregarNoticias();

// 2. GATILHO DA BUSCA (Entrar na Sala Segura)
function verificarBuscaOuGatilho() {
    const textoDigitado = campoBusca.value.trim();

    if (textoDigitado === SENHA_CORRETA) {
        campoBusca.value = "";
        
        // Alterna as classes das camadas de forma limpa
        telaJornal.className = 'camada-oculta';
        telaChat.className = 'camada-ativa';
        
        iniciarConexaoChat();
        iniciarMonitoramentoInatividade();
    } else {
        alert("Nenhum documento encontrado com o termo: " + textoDigitado);
        campoBusca.value = "";
    }
}

campoBusca.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
        verificarBuscaOuGatilho();
    }
});

// 3. SEGURANÇA POR INATIVIDADE (30s sem mexer volta para o jornal)
function bloquearPorInatividade() {
    telaChat.className = 'camada-oculta';
    telaJornal.className = 'camada-ativa';
    
    if (socket) socket.close();
    pararMonitoramentoInatividade();
}

function reiniciarCronometro() {
    clearTimeout(cronometroInatividade);
    cronometroInatividade = setTimeout(bloquearPorInatividade, TEMPO_INATIVIDADE);
}

function iniciarMonitoramentoInatividade() {
    reiniciarCronometro();
    window.addEventListener('mousemove', reiniciarCronometro);
    window.addEventListener('keypress', reiniciarCronometro);
    window.addEventListener('click', reiniciarCronometro);
    window.addEventListener('touchstart', reiniciarCronometro);
}

function pararMonitoramentoInatividade() {
    clearTimeout(cronometroInatividade);
    window.removeEventListener('mousemove', reiniciarCronometro);
    window.removeEventListener('keypress', reiniciarCronometro);
    window.removeEventListener('click', reiniciarCronometro);
    window.removeEventListener('touchstart', reiniciarCronometro);
}

// 4. SISTEMA DO CHAT
function iniciarConexaoChat() {
    const protocolo = window.location.protocol === 'https:' ? 'wss://' : 'ws://';
    socket = new WebSocket(protocol + window.location.host);

    socket.onopen = () => { 
        document.getElementById('statusConexao').innerText = "Online"; 
        document.getElementById('statusConexao').className = "status-online"; 
    };
    
    socket.onclose = () => { 
        document.getElementById('statusConexao').innerText = "Desconectado"; 
        document.getElementById('statusConexao').className = "status-offline"; 
    };

    socket.onmessage = (evento) => {
        const dados = JSON.parse(evento.data);
        exibirMensagem(dados.conteudo, dados.tipo, 'mensagem-outros');
    };
}

function enviarMensagemTexto() {
    const texto = mensagemInput.value.trim();
    if (texto !== "" && socket && socket.readyState === WebSocket.OPEN) {
        socket.send(JSON.stringify({ tipo: 'texto', conteudo: texto }));
        exibirMensagem(texto, 'texto', 'mensagem-minha');
        mensagemInput.value = "";
    }
}

mensagemInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') enviarMensagemTexto(); });

arquivoInput.addEventListener('change', function(evento) {
    const arquivo = evento.target.files[0];
    if (!arquivo) return;

    const leitor = new FileReader();
    leitor.onload = function(e) {
        const dadosBase64 = e.target.result;
        let tipoMensagem = arquivo.type.startsWith('image/') ? 'imagem' : 'arquivo';

        if (socket && socket.readyState === WebSocket.OPEN) {
            socket.send(JSON.stringify({ tipo: tipoMensagem, conteudo: dadosBase64 }));
            exibirMensagem(dadosBase64, tipoMensagem, 'mensagem-minha');
        }
    };
    leitor.readAsDataURL(arquivo);
    arquivoInput.value = ""; 
});

function exibirMensagem(conteudo, tipo, classeCSS) {
    const balao = document.createElement('div');
    balao.classList.add('mensagem', classeCSS);

    if (tipo === 'texto') { balao.innerText = conteudo; } 
    else if (tipo === 'imagem') { const img = document.createElement('img'); img.src = conteudo; balao.appendChild(img); } 
    else if (tipo === 'arquivo') { const link = document.createElement('a'); link.href = conteudo; link.download = "arquivo_recebido"; link.innerText = "📁 Baixar"; balao.appendChild(link); }

    areaMensagens.appendChild(balao);
    areaMensagens.scrollTop = areaMensagens.scrollHeight; 
}
